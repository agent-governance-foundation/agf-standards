{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-foundation.github.io/agf-standards/schemas/invalidation-record.schema.json",
  "title": "Invalidation Record (signed evidence)",
  "description": "Spec 07 \u00a711.5 \u2014 the signed AGF serialization of the kernel Invalidation (Spec 00 \u00a73.6) for a revoked Authority. Schema checks structure only; the event-time invariant, bindings and ordering are semantic rules (Spec 07 \u00a711.1, \u00a711.8) enforced by verifiers.",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "agf.invalidation"
        },
        "format_version": {
          "const": "1.0"
        },
        "record_id": {
          "type": "string",
          "pattern": "^inv_[A-Za-z0-9_]+$"
        },
        "org_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "const": "authority"
        },
        "cause": {
          "const": "revoked"
        },
        "occurred_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "detected_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "description": "Never null: Spec 00 \u00a73.6 requires actor when cause is revoked; system revocations use system:<component>."
        },
        "authorization_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Salted digest (Spec 07 \u00a711.2), or null when the field is empty.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "alg": {
                  "const": "HMAC-SHA256-SALT16"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                }
              },
              "required": [
                "alg",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "evidence": {
          "description": "Salted digest (Spec 07 \u00a711.2), or null when the field is empty.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "alg": {
                  "const": "HMAC-SHA256-SALT16"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                }
              },
              "required": [
                "alg",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "record_type",
        "format_version",
        "record_id",
        "org_id",
        "recorded_at",
        "subject",
        "subject_type",
        "cause",
        "occurred_at",
        "detected_at",
        "actor",
        "authorization_mode",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "description": "Outside the signed bytes (Spec 07 \u00a711.1, \u00a74.2, \u00a74.5).",
      "properties": {
        "signer": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "enum": [
            "ES256",
            "HMAC-SHA256"
          ]
        },
        "kid": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC 7638 thumbprint; required for ES256 (Spec 07 \u00a74.5)."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+={0,2}$"
        }
      },
      "required": [
        "signer",
        "algorithm",
        "kid",
        "signature"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "algorithm": {
            "const": "ES256"
          }
        }
      },
      "then": {
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    }
  },
  "required": [
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
