{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-governance-foundation.github.io/agf-standards/schemas/execution-validation-signed-record.schema.json",
  "title": "Execution Validation Record (signed evidence)",
  "description": "Spec 07 \u00a711.6 / Spec 30 \u00a74 \u2014 the Execution Validation Record, signed; record_id carries the record's existing id. Schema checks structure only; the event-time invariant, bindings and ordering are semantic rules (Spec 07 \u00a711.1, \u00a711.8) enforced by verifiers.",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "agf.execution_validation"
        },
        "format_version": {
          "const": "1.0"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "org_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "authority_refs_checked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "checked_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "result": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "authority_revoked",
              "authority_expired",
              "platform_halted"
            ]
          }
        },
        "invalidation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "record_type",
        "format_version",
        "record_id",
        "org_id",
        "recorded_at",
        "decision_ref",
        "authority_refs_checked",
        "checked_at",
        "result",
        "reasons",
        "invalidation_refs",
        "checked_by"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "result": {
            "const": "invalid"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "Outside the signed bytes (Spec 07 \u00a711.1, \u00a74.2, \u00a74.5).",
      "properties": {
        "signer": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "enum": [
            "ES256",
            "HMAC-SHA256"
          ]
        },
        "kid": {
          "type": [
            "string",
            "null"
          ],
          "description": "RFC 7638 thumbprint; required for ES256 (Spec 07 \u00a74.5)."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+={0,2}$"
        }
      },
      "required": [
        "signer",
        "algorithm",
        "kid",
        "signature"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "algorithm": {
            "const": "ES256"
          }
        }
      },
      "then": {
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    }
  },
  "required": [
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
